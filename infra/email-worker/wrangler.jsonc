{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "instant-tranquille-email",
  "account_id": "3bc01860f5cfd8922be4d225dfce3584",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["contact@instant-tranquille.com"]
    }
  ],
  "vars": {
    "EMAIL_FROM_ADDRESS": "contact@instant-tranquille.com",
    "EMAIL_FROM_NAME": "L'Instant Tranquille"
  },
  "secrets": {
    "required": ["EMAIL_WORKER_SECRET", "CONTACT_NOTIFY_TO"]
  }
}
